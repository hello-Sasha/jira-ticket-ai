# MySQL - job state machine
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pdf_converter

# MongoDB - source documents
MONGO_URI=mongodb://localhost:27017/documents

# AWS
AWS_REGION=us-west-2
RENDER_QUEUE_URL=
RENDER_QUEUE_URGENT_URL=
DEFAULT_BUCKET=

# Dispatcher tuning
CLAIM_CHUNK_SIZE=1000
LEASE_MINUTES=15
MAX_ATTEMPTS=3

# Render tuning
BROWSER_RECYCLE_AFTER=200
RENDER_TIMEOUT_MS=30000
